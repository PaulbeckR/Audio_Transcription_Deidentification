# Dockerfile for Whisper fine-tuning with GPU support
# Audio Transcription & Deidentification Project
# Includes all dependencies for LoRA fine-tuning
# Last Updated: 2026-01-09

FROM nvidia/cuda:12.1.0-cudnn8-devel-ubuntu22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    python3.10-dev \
    build-essential \
    ffmpeg \
    git \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.10 as default
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1

# Upgrade pip and install build tools
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install PyTorch 2.4.1 with CUDA 12.1 support (tested and verified version)
RUN pip install --no-cache-dir \
    torch==2.4.1 \
    torchaudio==2.4.1 \
    torchvision==0.19.1 \
    --index-url https://download.pytorch.org/whl/cu121

# Copy requirements and install base dependencies
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Copy fine-tuning requirements and install
COPY requirements_finetuning.txt /tmp/requirements_finetuning.txt
RUN pip install --no-cache-dir -r /tmp/requirements_finetuning.txt

# Create working directory
WORKDIR /workspace

# Set HuggingFace cache location
ENV HF_HOME=/workspace/.cache/huggingface

# Expose TensorBoard port
EXPOSE 6006

# Default command
CMD ["/bin/bash"]
